; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

run/main_scene="uid://v7hn7cr7wbqq"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*uid://d03drem24iphj"
Utils="*uid://cjtde2p06p32k"
PhantomCameraManager="*uid://duq6jhf6unyis"
MetSys="*uid://c01ibpvrp2wsd"
DialogueManager="*uid://c3rodes2l3gxb"
CollisionPresetRuntime="*uid://u810pt6u5apa"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/MetroidvaniaSystem/EditorExtension/plugin.cfg", "res://addons/MetroidvaniaSystem/plugin.cfg", "res://addons/collision_presets/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/dungeon_crawler_3d/plugin.cfg", "res://addons/go_build/plugin.cfg", "res://addons/go_placer/plugin.cfg", "res://addons/goactions/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg", "res://addons/level_block/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/scene_dependency_viewer/plugin.cfg", "res://addons/ui_builder/plugin.cfg", "res://addons/yard/plugin.cfg")

